[Unit]
Description=Propeller IMU and Web Control Service (direct ethernet, no internet)
Documentation=file:///home/han/imu_ws/web_server/setup_eth_direct.sh
After=NetworkManager.service network.target local-fs.target
Wants=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/home/han/imu_ws/web_server
ExecStart=/bin/bash /home/han/imu_ws/web_server/start_propeller_daemon.sh
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=15

[Install]
WantedBy=default.target
